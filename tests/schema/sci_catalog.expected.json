        {
          "name": "sci_parse_jobs_one_active",
          "definition": "CREATE UNIQUE INDEX sci_parse_jobs_one_active ON private.sci_parse_jobs USING btree (document_id) WHERE (status = ANY (ARRAY['queued'::text, 'running'::text]))"
        },
        {
